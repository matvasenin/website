---
import Separator from "./Separator.astro";
import IconHome from "~icons/solar/home-angle-bold"
import IconChat from "~icons/solar/chat-round-line-bold"
import IconDocument from "~icons/solar/document-text-bold"

const checkPath = (path: string) =>
  Astro.url.pathname.replaceAll(/(\w)\//g, "$1") === path ? "active" : ""
---

<nav>
  <a href="/" class={checkPath("/")}>
    <IconHome />
    <span>главная</span>
  </a>
  <Separator class="vertical" />
  <a href="/contact" class={checkPath("/contact")}>
    <IconChat />
    <span>контакты</span>
  </a>
  <Separator class="vertical" />
  <a href="/blog" class={checkPath("/blog")}>
    <IconDocument />
    <span>блог</span>
  </a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    height: 100%;
    width: fit-content;
    margin-inline: auto;
    padding: 0.75rem 1rem;
    background: var(--color-navbar);
    backdrop-filter: blur(16px);
    border-radius: 0 0 1rem 1rem;
    & a {
      display: flex;
      gap: 0.5rem;
      font-size: 1.5rem;
      transition: color .2s;
      &:not(.active, :hover) {
        color: var(--color-secondary-text);
      }
      @media (max-width: 40rem) {
        & span {
          display: none;
        }
      }
    }
  }
</style>
