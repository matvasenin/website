---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<"button">

const props = Astro.props;
---

<button {...props}>
  <span>
    <slot />
  </span>
</button>

<style is:global>
  button {
    display: flex;
    flex-direction: column;
    height: 4rem;
    margin: var(--border-width);
    padding: 0;
    border: 0;
    position: relative;
    cursor: pointer;
    width: 100%;
    &::before {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 3rem;
    }
    &::before, & > span {
      background: var(--color-paper);
      outline: var(--border-width) solid var(--color-primary);
      transition: .1s;
    }
    & > span {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      height: 3.25rem;
      padding: 0 0.75rem;
      position: relative;
    }
    &:enabled:hover, &:focus-visible {
      & > span {
        background: var(--color-accent);
        color: var(--color-accent-content);
      }
      &::before {
        background: var(--color-primary);
      }
    }
    &:disabled {
      cursor: not-allowed;
    }
    &:is(:active, :disabled) > span {
      translate: 0 0.75rem;
    }
  }
  .stack-x > button {
    &:not(:last-child) {
      margin-inline-end: 0;
    }
  }
  .stack-y > button {
    &:not(:last-child) {
      margin-block-end: 0;
    }
  }
</style>