---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"article"> {
  color?: "paper" | "primary" | "accent";
}
const { color = "paper", ...rest } = Astro.props;
---

<div class:list={["card", color, rest.class]} {...rest}>
  <slot />
</div>

<style is:global>
  .card {
    outline: var(--border-width) solid var(--color-primary);
    margin: var(--border-width);
    padding: 1rem;
    &.paper {
      background: var(--color-paper);
      color: var(--color-primary);
    }
    &.primary {
      background: var(--color-primary);
      color: var(--color-paper);
    }
    &.accent {
      background: var(--color-accent);
      color: var(--color-accent-content);
    }
  }
  .stack-x > .card {
    margin-inline: calc(var(--border-width) / 2);
    &:first-child {
      margin-inline-start: var(--border-width);
    }
    &:last-child {
      margin-inline-end: var(--border-width);
    }
  }
  .stack-y > .card {
    margin-block: calc(var(--border-width) / 2);
    &:first-child {
      margin-block-start: var(--border-width);
    }
    &:last-child {
      margin-block-end: var(--border-width);
    }
  }
</style>