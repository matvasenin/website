---
import IconArrowRight from "~icons/solar/arrow-right-linear"
import IconArrowDown from "~icons/solar/arrow-down-linear"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"a">
const props = Astro.props;
---

<a class="link" {...props}>
  <div>
    <slot />
    {
      props.href?.toString().startsWith("#")
        ? <IconArrowDown />
        : <IconArrowRight />
    }
  </div>
</a>

<style is:global>
  .link {
    display: flex;
    height: 4rem;
    text-decoration: none;
    position: relative;
    &::before {
      content: "";
      position: absolute;
      bottom: 0;
      height: 3rem;
      width: 100%;
      background: white;
      border: var(--border-width) solid var(--color-primary);
    }
    &::before, & > div {
      transition: .1s;
    }
    &:active > div {
      translate: 0 0.75rem;
    }
    &:hover {
      & > div {
        background: var(--color-accent);
        color: var(--color-paper);
      }
      &::before {
        background: var(--color-primary);
      }
    }
    & path {
      stroke-width: calc(var(--border-width) / 2);
    }
  }
  .link > div {
    display: flex;
    width: 100%;
    height: 3.25rem;
    padding-inline: 0.75rem;
    justify-content: space-between;
    border: var(--border-width) solid var(--color-primary);
    align-items: center;
    background: var(--color-paper);
    z-index: 10;
  }
</style>