---
import IconArrowRight from "~icons/solar/arrow-right-linear"
import IconArrowDown from "~icons/solar/arrow-down-linear"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"a">
const props = Astro.props;
---

<a class="link" {...props}>
  <span>
    <slot />
    {
      props.href?.toString().startsWith("#")
        ? <IconArrowDown />
        : <IconArrowRight />
    }
  </span>
</a>

<style is:global>
  .link {
    display: flex;
    position: relative;
    height: 4rem;
    width: 100%;
    margin: var(--border-width);
    text-decoration: none;
    &::before {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 3rem;
    }
    &::before, & > span {
      background: var(--color-paper);
      outline: var(--border-width) solid var(--color-primary);
      transition: .1s;
    }
    & > span {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      height: 3.25rem;
      padding-inline: 0.75rem;
      background: var(--color-paper);
      position: relative;
    }
    &:active > span {
      translate: 0 0.75rem;
    }
    &:hover, &:focus-visible {
      & > span {
        background: var(--color-accent);
        color: var(--color-accent-content);
      }
      &::before {
        background: var(--color-primary);
      }
    }
    & path {
      stroke-width: calc(var(--border-width) / 2);
    }
  }
</style>