---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<"section"> {
  image: ImageMetadata;
}
const { image, ...rest } = Astro.props;
---

<section
  style={`background-image: linear-gradient(rgb(255 255 255 / 0.75), rgb(255 255 255 / 0.75)), url("${image.src}")`}
  {...rest}
>
  {Astro.slots.has("header") && (
    <header>
      <slot name="header" />
    </header>
  )}
  <div>
    <slot />
  </div>
</section>

<style is:global>
  header {
    width: 100%;
    padding: 1rem;
    border-block: var(--border-width) solid var(--color-primary);
    background: var(--color-paper);
    @media (max-width: 35rem) {
      text-align: center;
    }
  }
  section {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow-x: hidden;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    image-rendering: pixelated;
    & > div {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 1rem;
    }
  }
</style>