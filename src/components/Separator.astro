---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<"hr">
const props = Astro.props;
---

<hr {...props} />

<style>
  hr {
    border: 0;
    margin: 0;
    border-radius: 1rem;
    background: var(--color-secondary);
    &.vertical {
      width: 2px;
    }
  }
</style>