---
import Root from "../layouts/Root.astro";
import IconTelegram from "~icons/simple-icons/telegram"
import IconGithub from "~icons/simple-icons/github"
import IconVK from "~icons/simple-icons/vk"
---

<Root title="Контакты">
  <div class="mailboxes">
    <a href="mailto:mat.vasenin@ya.ru">
      mat.vasenin@ya.ru
      <label>рабочий e-mail</label>
    </a>
    <a href="mailto:mat.vasenin@ya.ru">
      mat.vasenin@ya.ru
      <label>личный e-mail</label>
    </a>
  </div>
  <div class="socials">
    <a href="https://t.me/matvasenin">
      <IconTelegram />
      <label>Telegram</label>
    </a>
    <a href="https://vk.ru/matvasenin">
      <IconVK />
      <label>VK</label>
    </a>
    <a href="https://github.com/matvasenin">
      <IconGithub />
      <label>Github</label>
    </a>
  </div>
</Root>

<style>
  a {
    display: flex;
    font-size: 2.5rem;
    font-weight: 700;
  }
  svg {
    height: 3rem;
    width: auto;
  }
  body {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }
  div.mailboxes {
    display: flex;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    & a {
      flex-direction: column;
    }
    & label {
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--color-secondary-text);
    }
    @media (max-width: 55rem) {
      flex-direction: column;
    }
  }
  div.socials {
    display: grid;
    grid-template: auto / repeat(2, auto);
    gap: 1.5rem 2rem;
    & a {
      gap: 0.75rem;
      align-items: center;
    }
    @media (max-width: 40rem) {
      grid-auto-flow: column;
      gap: 1.5rem;
      & label {
        display: none;
      }
    }
  }
</style>