---
import Header from "@/components/Header.astro";
import Root from "@/layouts/Root.astro";

import SectionBoard from "@/layouts/sections/Board.astro";
import SectionHards from "@/layouts/sections/Hards.astro";
import SectionSofts from "@/layouts/sections/Softs.astro";
---

<Root title="Главная">
  <SectionBoard />
  <Header id="heading-hard-skills">
    <h2>Хард-скиллы</h2>
  </Header>
  <SectionHards />
  <Header id="heading-soft-skills">
    <h2>Софт-скиллы</h2>
  </Header>
  <SectionSofts />
  <Header id="heading-contacts">
    <h2>Контакты</h2>
  </Header>
</Root>