---
import "@fontsource-variable/inter/wght.css"
import "@fontsource-variable/jetbrains-mono/wght.css";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"main"> {
  title: string;
}
const { title, ...rest } = Astro.props;
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<main {...rest}>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--color-paper: white;
		--color-primary: hsl(0, 0%, 25%);
		--color-accent: hsl(215, 100%, 65%);
		--color-accent-content: white;
		--border-width: 3px;
		color: var(--color-primary);
		background: var(--color-paper);
		scroll-behavior: smooth;
		text-wrap: balance;
	}
	* {
		margin: 0;
		&, &::before, &::after {
			box-sizing: border-box;
		}
		font:
			600 clamp(1.25rem, 5vw, 1.5rem)/1.25
			"JetBrains Mono Variable", system-ui;
		&:is(h1) {
			font:
				700 clamp(3rem, 15vw, 4rem)/1
				"Inter Variable", system-ui;
		}
		&:is(h2) {
			font:
				700 clamp(2rem, 10vw, 3rem)/1
				"Inter Variable", system-ui;
		}
		&::selection {
			background: var(--color-primary);
			color: var(--color-paper);
		}
		&.primary::selection {
      background: var(--color-paper);
      color: var(--color-primary);
    }
		&:is(a, a:visited) {
			color: inherit;
		}
		-webkit-tap-highlight-color: transparent;
		&:focus-visible {
			outline: 0;
		}
	}
</style>