---
import Section from "@/components/Section.astro";
import Card from "@/components/Card.astro";
import Link from "@/components/Link.astro";
import ImageWater from "@/assets/images/water-slow.gif";
---

<Section image={ImageWater}>
  <div class="widget-profiler card-stack-y">
    <Card color="paper">
      <h1>Vasenin</h1>
    </Card>
    <Card color="accent" style="text-align: center">
      Junior-специалист в&nbsp;области&nbsp;ИБ
    </Card>
    <Card color="paper" style="text-align: end">
      <h1>Matvey</h1>
    </Card>
    <Card color="primary" style="text-align: start">
      Эффективность и&nbsp;обучаемость&nbsp;— мои приоритеты
    </Card>
  </div>
  <div class="widget-navigator">
    <Link href="#hard-skills">
Обо мне
    </Link>
    <Link href="#contacts">
Контакты
    </Link>
    <Link href="/blog">
Блог
    </Link>
  </div>
</Section>

<style is:global>
  .widget-profiler {
    display: flex;
    flex-direction: column;
    @media (min-width: 65rem) {
      max-width: 40rem;
      margin-block: auto;
    }
  }
  .widget-navigator {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    @media (min-width: 60rem) {
      flex-direction: row;
      & > * {
        flex: 1;
      }
    }
  }
</style>